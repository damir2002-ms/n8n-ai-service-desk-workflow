        "jsCode": "const raw = $json.content[0].text;\n\nconst cleaned = raw\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/\\s*```$/, '')\n  .trim();\n\nconst parsed = JSON.parse(cleaned);\n\nreturn {\n  json: {\n    criticality: parsed.criticality,\n    category: parsed.category,\n    draft_response: parsed.draft_response,\n  },\n};"
